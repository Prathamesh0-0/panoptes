# Auto-detect text files and normalise line endings to LF in the repo
* text=auto eol=lf

# Explicitly declare text files
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.rego  text eol=lf
*.env.example text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary — do not touch
*.exe   binary
*.db    binary
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pyc   binary
